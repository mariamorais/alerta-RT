DATABASE_URL=postgresql://alerta:alerta@localhost:5432/alerta_rt

# SAP S-User OAuth2 (create a technical user + API key in SAP for Me)
SAP_OAUTH_TOKEN_URL=https://api.sap.com/oauth/token
SAP_OAUTH_CLIENT_ID=
SAP_OAUTH_CLIENT_SECRET=
SAP_ODATA_BASE=https://launchpad.support.sap.com/services/odata/svt/snogwdcapi
SAP_DOWNLOAD_BASE=https://softwaredownloads.sap.com/file

# Scheduler
DISCOVER_INTERVAL_MIN=30
DOWNLOAD_CONCURRENCY=2

# Storage
SAR_DIR=./storage/sar
SAPCAR_BIN=/usr/local/bin/SAPCAR
